# what the dev server and the tests keep
/build/
# this machine's settings for the scripts in docker/, such as where the games are installed (.env.example)
/.env
# game files that are kept in the checkout. Never commit them.
/game/
# what the server in compose.yaml writes
/config/
# editors and tools
/.vscode/
node_modules/
__pycache__/
# Claude Code: agent worktrees and personal settings (.claude/settings.json is shared)
/.claude/worktrees/
/.claude/settings.local.json
# the launcher's icon and manifest, which go-winres makes for its build (.github/workflows/launcher.yml)
/launcher/*.syso
# the built page (docker/web.sh, or npm run build in web/)
/web/dist/
